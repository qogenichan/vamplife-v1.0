local function manageEspForModel(model, prefix, enabled, customColor, customTransparency)
    if not model or not model:FindFirstChild("HumanoidRootPart") then return end
    local hrp = model.HumanoidRootPart
    local existingEsp = hrp:FindFirstChild("VampireESP")
    
    if enabled and model:FindFirstChild("Humanoid") and model.Humanoid.Health > 0 then
        if not existingEsp then
            local bill = Instance.new("BillboardGui")
            bill.Name = "VampireESP"
            bill.Size = UDim2.new(0, 100, 0, 40)
            bill.StudsOffset = Vector3.new(0, 3, 0)
            bill.AlwaysOnTop = true
            bill.Parent = hrp
            
            local lbl = Instance.new("TextLabel")
            lbl.Size = UDim2.new(1, 0, 1, 0)
            lbl.BackgroundTransparency = 1
            lbl.Font = Enum.Font.GothamBold
            lbl.TextSize = 12
            lbl.TextStrokeTransparency = 0.5
            lbl.Parent = bill
            
            table.insert(activeEspObjects, bill)
        end
        
        local bill = hrp.VampireESP
        local lbl = bill.TextLabel
        lbl.TextColor3 = customColor or Color3.fromRGB(255, 255, 255)
        lbl.TextTransparency = customTransparency or 0.3
        
        local dist = player.Character and player.Character:FindFirstChild("HumanoidRootPart") and math.floor((hrp.Position - player.Character.HumanoidRootPart.Position).Magnitude) or 0
        lbl.Text = string.format("[%s]\n[%dm]", prefix, dist)
    else
        if existingEsp then existingEsp:Destroy() end
    end
end

local function getPlayerRaceAndColor(plrChar)
    local raceName = "Player"
    if plrChar:FindFirstChild("Werewolf") or plrChar:FindFirstChild("WolfTag") or string.find(string.lower(plrChar.Name), "wolf") then
        raceName = "Werewolf"
    elseif plrChar:FindFirstChild("VampireTag") or string.find(string.lower(plrChar.Name), "vampire") then
        raceName = "Vampire"
    end
    return raceName
end

RunService.RenderStepped:Connect(function()
    if not scriptRunning then return end
    
    local huntersFolder = workspace:FindFirstChild("NPCS") and workspace.NPCS:FindFirstChild("HUNTERS")
    if huntersFolder then
        for _, obj in pairs(huntersFolder:GetChildren()) do
            if string.find(obj.Name, "Hunter") then manageEspForModel(obj, "Hunter", espHunter, Color3.fromRGB(255, 120, 50), 0.2) end
        end
    end
    
    local guardsFolder = workspace:FindFirstChild("NPCS") and workspace.NPCS:FindFirstChild("ACTIVE_GUARDS")
    if guardsFolder then
        for _, obj in pairs(guardsFolder:GetChildren()) do
            if string.find(obj.Name, "Guard") then manageEspForModel(obj, "Guard", espGuard, Color3.fromRGB(200, 200, 50), 0.2) end
        end
    end
    
    local humansFolder = workspace:FindFirstChild("Humans")
    if humansFolder then
        for _, obj in pairs(humansFolder:GetChildren()) do
            if obj.Name == "Human" then manageEspForModel(obj, "Human", espHuman, Color3.fromRGB(50, 150, 255), 0.2) end
        end
    end

    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= player and plr.Character then
            local race = getPlayerRaceAndColor(plr.Character)
            manageEspForModel(plr.Character, plr.Name .. " (" .. race .. ")", espPlayer, Color3.fromRGB(240, 240, 240), 0.3)
        end
    end
end)

