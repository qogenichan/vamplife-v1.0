-- DİNAMİK MESAFE (OFFSET) AYARLAYICI
-- ==========================================
local function updateOffsets()
    local ySafe = 12
    local yAttack = 4.5
    local zAttack = 1.0

    if farmMode == "VampireMonster" then
        ySafe = 15       
        yAttack = 3.0    
        zAttack = 0.0    
    elseif farmMode == "Human" then
        ySafe = 12
        yAttack = 3.2    
        zAttack = 0.5    
    elseif farmMode == "Hunter" or farmMode == "Guard" then
        ySafe = 12
        yAttack = 4.5
        zAttack = 1.0
    end

    if attackDirection == "Alt" then
        safeOffset = CFrame.new(0, -ySafe, 0)
        attackOffset = CFrame.new(0, -yAttack, -zAttack)
    elseif attackDirection == "Üst" then
        safeOffset = CFrame.new(0, ySafe, 0)
        attackOffset = CFrame.new(0, yAttack, -zAttack)
    elseif attackDirection == "Arka" then
        safeOffset = CFrame.new(0, 0, ySafe)
        local backZ = 3.5
        if farmMode == "VampireMonster" then backZ = 4.0 end
        if farmMode == "Human" then backZ = 2.5 end 
        attackOffset = CFrame.new(0, 0, backZ) 
    end
end

