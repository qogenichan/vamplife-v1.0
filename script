task.spawn(function()
    while task.wait() do 
        if not scriptRunning then break end
        if farmMode ~= "None" and currentTarget and currentTarget:FindFirstChild("Humanoid") and currentTarget.Humanoid.Health > 0 then
            if farmMode == "Guard" then
                currentOffset = attackOffset
                task.wait(0.15) 
                fireRemoteAttack()
                task.wait(0.35)
                currentOffset = safeOffset
                task.wait(0.75)
            else
                currentOffset = attackOffset
                task.wait(0.15) 
                fireRemoteAttack()
                task.wait(0.45)
                currentOffset = safeOffset
                task.wait(0.08) 
            end
        else
            task.wait(0.1)
        end
    end
end)

RunService.Heartbeat:Connect(function()
    if not scriptRunning or isTeleporting then return end
    if farmMode ~= "None" and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
        local hrp = player.Character.HumanoidRootPart
        if not currentTarget or not currentTarget.Parent or not currentTarget:FindFirstChild("Humanoid") or currentTarget.Humanoid.Health <= 0 then
            currentTarget = getNextTarget()
            currentOffset = safeOffset
            if currentTarget then attackTimer = tick(); lastHealth = currentTarget.Humanoid.Health end
        end
        if currentTarget then
            local targetPart = nil
            if farmMode == "Hunter" or farmMode == "Human" or farmMode == "Guard" then
                targetPart = currentTarget:FindFirstChild("HumanoidRootPart")
            elseif farmMode == "VampireMonster" then
                targetPart = currentTarget:FindFirstChild("VAMPIRE_VAMPIRE_0")
            end
            if targetPart then
                local currentHealth = currentTarget.Humanoid.Health
                if currentHealth < lastHealth then lastHealth = currentHealth; attackTimer = tick() end
                local timeoutLimit = (farmMode == "Guard") and 5 or ((farmMode == "VampireMonster") and 8 or 4)
                if tick() - attackTimer > timeoutLimit then
                    blacklistedTargets[currentTarget] = true
                    currentTarget = nil 
                    currentOffset = safeOffset
                    return 
                end
                local targetPosition = (targetPart.CFrame * currentOffset).Position
                hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                hrp.CFrame = CFrame.lookAt(targetPosition, targetPart.Position)
            end
        end
    end
end)
