-- DİNAMİK MESAFE (Kararlı Yön Ayarları)
-- ==========================================
local function getTargetOffsets(target)
    local ySafe = 12; local yAttack = 3.2; local zAttack = 0.5
    local tName = target and string.lower(target.Name) or ""
    
    if string.find(tName, "vampire") then ySafe = 15; yAttack = 3.0; zAttack = 0.0
    elseif string.find(tName, "hunter") or string.find(tName, "guard") then ySafe = 12; yAttack = 3.2; zAttack = 1.0 end 
    
    local sOff = CFrame.new(0, -ySafe, 0)
    local aOff = CFrame.new(0, -yAttack, -zAttack)
    
    if attackDirection == "Üst" then 
        sOff = CFrame.new(0, ySafe, 0); aOff = CFrame.new(0, yAttack, -zAttack)
    elseif attackDirection == "Arka" then
        sOff = CFrame.new(0, 0, ySafe)
        local backZ = 3.5; if string.find(tName, "vampire") then backZ = 4.0 end
        aOff = CFrame.new(0, 0, backZ) 
    end
    return sOff, aOff
end

