    local network = ReplicatedStorage:FindFirstChild("Network")
    if network and network:FindFirstChild("Combat") and network.Combat:FindFirstChild("BloodDrinkRequest") then pcall(function() network.Combat.BloodDrinkRequest:FireServer(target); network.Combat.BloodDrinkRequest:FireServer() end) end
    
    pcall(function()
        if keypress then keypress(0x45); task.wait(0.6); keyrelease(0x45)
        else VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game); task.wait(0.6); VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game) end
    end)
end

