local function getBloodLevel()
    local char = player.Character
    if char then
        local sv = char:FindFirstChild("StaminaViewer")
        if sv and sv:FindFirstChild("BloodBackground") and sv.BloodBackground:FindFirstChild("BloodFill") then
            return sv.BloodBackground.BloodFill.Size.Y.Scale
        end
    end
    return 1 
end

-- ==========================================
-- HIZLI TELEPORT
-- ==========================================
local function walkTeleportTo(targetPosition)
    if isTeleporting then return end
    isTeleporting = true
    task.spawn(function()
        local char = player.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") or not char:FindFirstChild("Humanoid") then isTeleporting = false; return end
        local hrp = char.HumanoidRootPart; local humanoid = char.Humanoid; local originalSpeed = humanoid.WalkSpeed
        humanoid.WalkSpeed = 300
        local speedConnection
        speedConnection = RunService.Heartbeat:Connect(function() if isTeleporting and humanoid and humanoid.Parent then humanoid.WalkSpeed = 300 else if speedConnection then speedConnection:Disconnect() end end end)
        local path = PathfindingService:CreatePath({ AgentRadius = 2, AgentHeight = 5, AgentCanJump = true, WaypointSpacing = 3, Costs = { Water = 20 } })
        local success = pcall(function() path:ComputeAsync(hrp.Position, targetPosition) end)
        if success and path.Status == Enum.PathStatus.Success then
            for _, waypoint in ipairs(path:GetWaypoints()) do
                if not scriptRunning or not char or humanoid.Health <= 0 then break end
                humanoid:MoveTo(waypoint.Position)
                if waypoint.Action == Enum.PathWaypointAction.Jump then humanoid.Jump = true end
                local reached = false; local connection = humanoid.MoveToFinished:Connect(function() reached = true; if connection then connection:Disconnect() end end)
                local t = tick(); while not reached and tick() - t < 1.0 do task.wait(0.02) end
                if connection then connection:Disconnect() end
            end
        else
            while scriptRunning and char and hrp and humanoid.Health > 0 do
                local dist = (Vector3.new(targetPosition.X, hrp.Position.Y, targetPosition.Z) - hrp.Position).Magnitude
                if dist < 5 then break end; humanoid:MoveTo(targetPosition); task.wait(0.05)
            end
        end
        if speedConnection then speedConnection:Disconnect() end
        if humanoid and humanoid.Parent then humanoid.WalkSpeed = originalSpeed end
        isTeleporting = false
    end)
end

