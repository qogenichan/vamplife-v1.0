-- ANA DÖNGÜ (İZOLASYON & STABİL VUR-KAÇ)
-- ==========================================
task.spawn(function()
    while task.wait() do 
        if not scriptRunning then break end
        
        if autoFeed and getBloodLevel() < 0.25 and not isFeeding then
            isFeeding = true
            if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                originalPosBeforeFeed = player.Character.HumanoidRootPart.Position
            end
            
            feedTarget = getClosestHumanForFeeding()
            if feedTarget then
                task.wait(0.6) 
                performBloodDrink(feedTarget)
                task.wait(8) 
                
                if originalPosBeforeFeed and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                    player.Character.HumanoidRootPart.CFrame = CFrame.new(originalPosBeforeFeed)
                    task.wait(0.3)
                end
            end
            isFeeding = false
            feedTarget = nil
            
        elseif not isFeeding then
            local isAnyFarmActive = farmTargets.Hunter or farmTargets.HunterBoss or farmTargets.Human or farmTargets.Guard or farmTargets.VampireMonster
            if isAnyFarmActive and currentTarget and currentTarget:FindFirstChild("Humanoid") and currentTarget.Humanoid.Health > 0 then
                currentOffset = attackOffset
                task.wait(0.12) 
                fireRemoteAttack()
                task.wait(0.3)
                currentOffset = safeOffset
                task.wait(0.15) 
            else
                task.wait(0.1)
            end
        end
    end
end)

-- ==========================================
-- POZİSYONLAMA (HEARTBEAT - KUSURSUZ MESAFE KORUMA)
-- ==========================================
RunService.Heartbeat:Connect(function()
    if not scriptRunning or isTeleporting then return end
    local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if isFeeding then
        if feedTarget and feedTarget:FindFirstChild("HumanoidRootPart") then
            local tHrp = feedTarget.HumanoidRootPart
            local targetPosition = (tHrp.CFrame * CFrame.new(0, 0, 3.5)).Position
            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            hrp.CFrame = CFrame.lookAt(targetPosition, tHrp.Position)
        end
        return
    end

    local isAnyFarmActive = farmTargets.Hunter or farmTargets.HunterBoss or farmTargets.Human or farmTargets.Guard or farmTargets.VampireMonster
    if not isAnyFarmActive then return end

    if not currentTarget or not currentTarget.Parent or not currentTarget:FindFirstChild("Humanoid") or currentTarget.Humanoid.Health <= 0 then
        currentTarget = getNextTarget()
        if currentTarget then attackTimer = tick(); lastHealth = currentTarget.Humanoid.Health end
    end
    
    if currentTarget then
        local targetPart = currentTarget:FindFirstChild("HumanoidRootPart")
        local tName = string.lower(currentTarget.Name)
        if string.find(tName, "vampire") then targetPart = currentTarget:FindFirstChild("VAMPIRE_VAMPIRE_0") or targetPart end
        
        if targetPart then
            local currentHealth = currentTarget.Humanoid.Health
            if currentHealth < lastHealth then lastHealth = currentHealth; attackTimer = tick() end
            
            if tick() - attackTimer > 3.5 then
                blacklistedTargets[currentTarget] = true
                currentTarget = nil 
                return 
            end
            
            local sOff, aOff = getTargetOffsets(currentTarget)
            local activeOffset = (currentOffset == attackOffset) and aOff or sOff
            local dynamicTargetCFrame = targetPart.CFrame
            
            if activeOffset == aOff and not string.find(tName, "vampire") then
                local strafeAngle = math.sin(tick() * 5) * 1.2 
                dynamicTargetCFrame = dynamicTargetCFrame * CFrame.Angles(0, strafeAngle, 0)
            end
            
            local targetPosition = (dynamicTargetCFrame * activeOffset).Position
            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            hrp.CFrame = CFrame.lookAt(targetPosition, targetPart.Position)
        end
    end
end)
