-- ==========================================
-- HEDEF BULMA (Kararlı Harmanlanmış Algoritma)
-- ==========================================
local function getNextTarget()
    local bestTarget = nil; local lowestHealth = math.huge; local shortestDistance = math.huge
    if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then return nil end
    local myPos = player.Character.HumanoidRootPart.Position
    
    local function evaluateTarget(obj, isVampireType)
        if not obj or blacklistedTargets[obj] or not obj:FindFirstChild("Humanoid") or obj.Humanoid.Health <= 0 then return end
        local hrp = obj:FindFirstChild("HumanoidRootPart")
        if isVampireType then hrp = obj:FindFirstChild("VAMPIRE_VAMPIRE_0") or hrp end
        
        if hrp then
            local hp = obj.Humanoid.Health; local dist = (hrp.Position - myPos).Magnitude
            if hp < lowestHealth then lowestHealth = hp; shortestDistance = dist; bestTarget = obj
            elseif hp == lowestHealth and dist < shortestDistance then shortestDistance = dist; bestTarget = obj end
        end
    end

    local function scanFolder(folder, matchStr, isVampire, excludeBoss)
        if not folder then return end
        for _, obj in pairs(folder:GetChildren()) do
            if string.find(obj.Name, matchStr) then
                if excludeBoss and string.find(obj.Name, "Boss") then continue end
                if not excludeBoss and matchStr == "Hunter" and not string.find(obj.Name, "Boss") then continue end
                evaluateTarget(obj, isVampire)
            end
        end
    end

    if farmTargets.Hunter then scanFolder(workspace:FindFirstChild("NPCS") and workspace.NPCS:FindFirstChild("HUNTERS"), "Hunter", false, true) end
    if farmTargets.HunterBoss then scanFolder(workspace:FindFirstChild("NPCS") and workspace.NPCS:FindFirstChild("HUNTERS"), "HunterBoss", false, false) end
    if farmTargets.Human then scanFolder(workspace:FindFirstChild("Humans"), "Human", false, false) end
    if farmTargets.Guard then scanFolder(workspace:FindFirstChild("NPCS") and workspace.NPCS:FindFirstChild("ACTIVE_GUARDS"), "Guard", false, false) end
    if farmTargets.VampireMonster then scanFolder(workspace:FindFirstChild("VampireMonsters"), "Vampire Monster", true, false) end
    return bestTarget
end

-- ==========================================
-- OTO BESLENME HEDEF BULUCU (Sadece Human)
-- ==========================================
local function getClosestHumanForFeeding()
    local bestTarget = nil; local shortestDist = math.huge
    if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then return nil end
    local myPos = player.Character.HumanoidRootPart.Position
    local humansFolder = workspace:FindFirstChild("Humans")
    if humansFolder then
        for _, obj in pairs(humansFolder:GetChildren()) do
            if string.find(obj.Name, "Human") and obj:FindFirstChild("Humanoid") and obj.Humanoid.Health > 0 then
                local hrp = obj:FindFirstChild("HumanoidRootPart")
                if hrp and hrp:FindFirstChildWhichIsA("ProximityPrompt") then
                    local dist = (hrp.Position - myPos).Magnitude
                    if dist < shortestDist then shortestDist = dist; bestTarget = obj end
                end
            end
        end
    end
    return bestTarget
end

